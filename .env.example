# Copier ce fichier en .env puis adapter. Les lignes commençant par # sont ignorées.

# Port d'écoute (80 en production sur le serveur, 3000 en local)
PORT=3000

# "production" ou "test" (test = bandeau « Environnement de test » sur les pages)
APP_ENV=production

# Titre affiché dans l'onglet du navigateur
SITE_TITLE=Food Trucks Basso Cambo

# Dossier des données (CSV et journaux), relatif au dossier de l'application
DATA_DIR=data

# Espace administrateur (/admin/) : laisser ADMIN_PASSWORD vide le désactive
ADMIN_USER=admin
ADMIN_PASSWORD=

# Adresse affichée dans le lien « Envoyez-moi un mail » de la page d'accueil (vide = lien masqué)
CONTACT_EMAIL=

# Mail envoyé à l'administrateur à chaque ajout d'établissement (SMTP_HOST vide = pas de mail)
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Serveur SMTP interne avec certificat non reconnu : true
SMTP_IGNORE_TLS_ERRORS=false
MAIL_FROM=noreply@foodtrucks.local
# Destinataire du mail envoyé à chaque ajout d'établissement par un collègue (par défaut : CONTACT_EMAIL)
MAIL_TO=

# Derrière un proxy inverse (IIS, nginx…) : adresse(s) du proxy dont on accepte l'en-tête X-Forwarded-For,
# pour journaliser la vraie IP du visiteur. « loopback » si le proxy est sur le même serveur, sinon son adresse IP
# (ou une liste séparée par des virgules). « true » est accepté mais déconseillé (IP falsifiable). Sans proxy : false.
TRUST_PROXY=false

# false pour ne plus remplir le journal technique data/acces-AAAA-MM.log
ACCESS_LOG=true

# Sauvegarde quotidienne de data/ (CSV, JSON, JSONL) : dossier de destination (par défaut « sauvegardes »
# à côté du dossier des données) et nombre de jours conservés
BACKUP_DIR=
BACKUP_DAYS=30

# Secret servant à rendre anonymes les identifiants de navigateur dans les journaux (HMAC).
# Vide = généré automatiquement et enregistré dans data/secret-stats.json (recommandé). Ne pas le changer ensuite :
# tous les navigateurs apparaîtraient comme nouveaux.
STATS_SECRET=

# Limites de fréquence des écritures publiques, par navigateur et par heure (par adresse IP : × LIMITE_FACTEUR_IP,
# car plusieurs postes peuvent partager une adresse). 0 = pas de limite.
# Contributions (ajouts, modifications, avis, présences, signalements) par navigateur et par heure
LIMITE_CONTRIBUTIONS=60
LIMITE_EVENEMENTS=600
LIMITE_FACTEUR_IP=5

# Écritures (ajouts, avis…) acceptées uniquement depuis les pages du site : l'en-tête Origin envoyé par le navigateur
# doit correspondre à l'adresse demandée. Si le site est derrière un proxy qui change le nom d'hôte, ou joignable sous
# plusieurs noms, listez-les ici (nom ou nom:port, séparés par des virgules). Ex. : foodtrucks,foodtrucks.entreprise.local
HOTES_AUTORISES=
